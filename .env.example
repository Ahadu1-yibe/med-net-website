# ─── Required (all environments) ─────────────────────────────────────────────
# PostgreSQL connection string.
# PRODUCTION (Vercel): use a free hosted Postgres such as Neon (no credit card
# required): https://neon.tech → copy the pooled connection string.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/mednet?sslmode=require"

# Long random string used to sign admin session tokens. Generate with:
#   openssl rand -hex 32
# NEVER reuse a secret from another project. Never commit the real value.
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Public URL of the deployed site (used for SEO, sitemap, Open Graph).
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Initial admin account (used ONLY by the seed script) ────────────────────
# The seed creates this account if it does not exist. Choose a strong, unique
# password (minimum 12 characters). Credentials are never committed to git.
# To rotate a password later, use the Admin Users page in the dashboard.
ADMIN_EMAIL="you@med-net.org"
ADMIN_NAME="Med-Net Admin"
ADMIN_PASSWORD="choose-a-strong-unique-password"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("ADMIN")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Project {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  summary      String
  description  String    @default("")
  category     String    @default("digital-health")
  status       String    @default("in-progress")
  problem      String    @default("")
  approach     String    @default("")
  impact       String    @default("")
  technologies String    @default("[]")
  team         String    @default("[]")
  externalUrl  String?
  repoUrl      String?
  coverImage   String?
  gallery      String    @default("[]")
  tags         String    @default("[]")
  featured     Boolean   @default(false)
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, featured])
  @@index([category])
}

model ResearchItem {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  description String    @default("")
  category    String    @default("digital-health")
  status      String    @default("ongoing")
  authors     String    @default("[]")
  externalUrl String?
  coverImage  String?
  tags        String    @default("[]")
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, featured])
  @@index([category])
}

model LearningResource {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  summary     String
  description String    @default("")
  type        String    @default("article")
  level       String    @default("beginner")
  externalUrl String?
  coverImage  String?
  tags        String    @default("[]")
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, type])
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  type            String    @default("NEWS")
  excerpt         String
  description     String    @default("")
  coverImage      String?
  location        String?
  startAt         DateTime?
  endAt           DateTime?
  registrationUrl String?
  tags            String    @default("[]")
  featured        Boolean   @default(false)
  published       Boolean   @default(false)
  publishAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, type])
  @@index([startAt])
}

model Opportunity {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  type         String    @default("VOLUNTEER")
  location     String?
  description  String    @default("")
  requirements String    @default("")
  deadline     DateTime?
  applyUrl     String?
  applyEmail   String?
  status       String    @default("OPEN")
  featured     Boolean   @default(false)
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published, status])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  websiteUrl  String?
  logoImage   String?
  tier        String   @default("COLLABORATING")
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  mimeType    String
  size        Int      @default(0)
  kind        String   @default("UPLOAD")
  externalUrl String?
  alt         String   @default("")
  data        Bytes?
  createdAt   DateTime @default(now())
}

model MembershipApplication {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  institution  String
  discipline   String
  location     String?
  interests    String   @default("[]")
  skills       String?
  motivation   String
  portfolioUrl String?
  consent      Boolean  @default(false)
  status       String   @default("NEW")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([status])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String   @default("GENERAL")
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model SiteSettings {
  id   String @id @default("singleton")
  data String
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime   @default(now())
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
